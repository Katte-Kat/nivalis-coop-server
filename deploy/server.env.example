# Copy to server.env (same folder). One NIVALIS_COOP_<SETTING> per line, no quotes.
# Everything here is optional; the defaults are in server/nivalis_coop/config.py.

NIVALIS_COOP_NAME=My Nivalis Coop server
NIVALIS_COOP_MOTD=Welcome to the restaurant
NIVALIS_COOP_MAX_PLAYERS=8

# Set a password before the port is forwarded on the router.
# NIVALIS_COOP_PASSWORD=change-me

# Only listed names may join: 'podman exec nivalis-coop python -m nivalis_coop ctl whitelist add <name>'
# NIVALIS_COOP_WHITELIST=true

# Keys under these prefixes may be written by every player (ops may write anywhere).
# NIVALIS_COOP_STATE_WRITE_PREFIXES=world/,shared/

# NIVALIS_COOP_TICK_RATE=20
# NIVALIS_COOP_AUTOSAVE_SECONDS=300
# NIVALIS_COOP_LOG_LEVEL=INFO
