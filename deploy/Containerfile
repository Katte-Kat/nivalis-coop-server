# Nivalis Coop server. Build context is ../server:
#   podman build -f deploy/Containerfile -t localhost/nivalis-coop:latest server/
FROM docker.io/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NIVALIS_COOP_DATA_DIR=/data

# Unprivileged user; in a rootless podman its uid is a subuid of the host user,
# so even a container escape would not own the host user's files.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin coop \
 && mkdir /data && chown coop:coop /data

WORKDIR /app
COPY nivalis_coop/ /app/nivalis_coop/

USER 10001:10001
VOLUME /data
EXPOSE 27800/tcp
STOPSIGNAL SIGTERM

ENTRYPOINT ["python", "-m", "nivalis_coop"]
